// Prisma schema for the Member Hub.
//
// The `User`, `Session`, `Account` and `Verification` models follow the shape
// that better-auth's Prisma adapter expects. The remaining models
// (`Post`, `Resource`, `DevEmail`) are hub-specific domain data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum MembershipTier {
  FREE
  PRO
  LIFETIME
}

enum ResourceType {
  DOCUMENT
  VIDEO
  AUDIO
  LINK
  FILE
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  emailVerified  Boolean         @default(false)
  image          String?
  role           String          @default("user")
  // Extended profile fields (managed by better-auth `additionalFields`).
  bio            String?
  membershipTier MembershipTier  @default(FREE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  posts    Post[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

/// Exclusive member content. `minimumTier` controls who can read it
/// (FREE = everyone logged in, PRO = Pro and Lifetime, LIFETIME = Lifetime only).
model Post {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  excerpt     String?
  content     String
  coverImage  String?
  minimumTier MembershipTier @default(FREE)
  published   Boolean        @default(true)
  authorId    String
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([minimumTier])
  @@map("post")
}

/// Downloadable / linked member resources.
model Resource {
  id          String         @id @default(cuid())
  title       String
  description String?
  url         String
  type        ResourceType   @default(LINK)
  sizeLabel   String?
  minimumTier MembershipTier @default(FREE)
  published   Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([minimumTier])
  @@map("resource")
}

/// Development-only mailbox. In production `sendMail` should call an SMTP
/// provider instead; in development we persist the message (including the
/// verification / reset links) so flows can be tested without a mail server.
model DevEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  createdAt DateTime @default(now())

  @@map("dev_email")
}
