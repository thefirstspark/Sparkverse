# Copy to .env and fill in real values. See README for the full guide.

# SQLite for local development. Switch to Postgres for production:
#   DATABASE_URL="postgresql://user:password@host:5432/memberhub"
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-64-character-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# --- Optional: Google OAuth (bonus login) -------------------------------
# 1. Create a project at https://console.cloud.google.com/apis/credentials
# 2. Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Optional: production email via Resend (https://resend.com) ----------
# In development, emails (verification/reset) are stored in the DevMail table
# and printed to the terminal instead of being sent.
# RESEND_API_KEY=
# MAIL_FROM="Sparkverse Member Hub <no-reply@yourdomain.com>"

# --- Optional: Stripe for real payments (the upgrade buttons simulate this) --
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
