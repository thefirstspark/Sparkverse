    .cta {
      text-align: center;
      margin: 3rem 0;
    }
    .cta a {
      background: linear-gradient(135deg, var(--violet), var(--cyan));
      color: white;
      padding: 1rem 2.5rem;
      border-radius: 12px;
      text-decoration: none;
      font-weight: 600;
      font-size: 1.2rem;
      transition: all 0.3s;
    }
    .cta a:hover {
      transform: scale(1.05);
      box-shadow: 0 0 30px rgba(144,96,224,0.5);
    }
