<style>
:root{
  --void:#060612;
  --deep:#0d0d24;
  --ivory:#e9e6db;
  --slate:#8b93b8;
  --faint:#4a5070;
  --ember:#c9a24b;
  --ember-hot:#ffe9b0;
  --twin-a:#4dd0e1;
  --twin-b:#e57bd8;
  --hairline:rgba(139,147,184,0.18);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  background:var(--void);
  color:var(--ivory);
  font-family:'Spectral',Georgia,serif;
  font-weight:300;
  line-height:1.8;
  -webkit-font-smoothing:antialiased;
}
::selection{background:rgba(201,162,75,0.35);color:#fff}

.mono{font-family:'JetBrains Mono',monospace;font-weight:300;letter-spacing:0.18em;text-transform:uppercase;font-size:11px}
.display{font-family:'Cormorant Garamond',Georgia,serif;font-weight:300}

/* ---------- header ---------- */
header{
  position:fixed;top:0;left:0;right:0;z-index:50;
  display:flex;justify-content:space-between;align-items:center;
  padding:20px 28px;
  background:linear-gradient(to bottom,rgba(6,6,18,0.85),rgba(6,6,18,0));
}
header a{color:var(--slate);text-decoration:none;transition:color .3s}
header a:hover{color:var(--ember)}
header a:focus-visible{outline:1px solid var(--ember);outline-offset:4px}
.brand{color:var(--ember)}

/* ---------- hero / instrument ---------- */
.instrument{
  position:relative;height:100vh;min-height:640px;overflow:hidden;
}
#sky{position:absolute;inset:0;width:100%;height:100%;display:block;cursor:pointer}
.veil{
  position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(ellipse at center,rgba(6,6,18,0) 55%,rgba(6,6,18,0.75) 100%);
}
.title-block{
  position:absolute;top:14vh;left:0;right:0;text-align:center;pointer-events:none;
  transition:opacity 1.6s ease;
}
.title-block .mono{color:var(--faint);margin-bottom:18px}
.title-block h1{
  font-family:'Cormorant Garamond',Georgia,serif;font-weight:300;
  font-size:clamp(44px,8vw,92px);letter-spacing:0.04em;line-height:1.05;
  color:var(--ivory);
}
.title-block h1 em{font-style:italic;color:var(--ember)}
.title-block .sub{color:var(--slate);font-size:15px;margin-top:16px;font-style:italic}

.stage-chrome{
  position:absolute;left:0;right:0;bottom:0;padding:0 28px 34px;
  display:flex;flex-direction:column;align-items:center;gap:18px;
}
.act-row{display:flex;align-items:center;gap:16px}
#actLabel{color:var(--ember);opacity:0.9}
.dots{display:flex;gap:8px}
.dots i{width:5px;height:5px;border-radius:50%;background:var(--faint);transition:background .6s,transform .6s;display:block}
.dots i.lit{background:var(--ember);transform:scale(1.25)}
#narr{
  font-family:'Cormorant Garamond',Georgia,serif;font-weight:400;font-style:italic;
  font-size:clamp(19px,2.6vw,26px);line-height:1.55;text-align:center;
  max-width:680px;min-height:3.2em;color:var(--ivory);
  transition:opacity .7s ease;
  text-shadow:0 2px 24px rgba(6,6,18,0.9);
}
#hint{color:var(--slate);font-size:13px;font-style:italic;min-height:1.4em;transition:opacity .5s}
#dist{
  position:absolute;right:28px;bottom:30px;color:var(--faint);
  font-size:11px;letter-spacing:0.14em;
}
button.act-btn{
  font-family:'JetBrains Mono',monospace;font-weight:300;letter-spacing:0.22em;text-transform:uppercase;
  font-size:11px;color:var(--ember);background:transparent;
  border:1px solid rgba(201,162,75,0.45);border-radius:2px;
  padding:12px 34px;cursor:pointer;transition:all .4s;
}
button.act-btn:hover{background:rgba(201,162,75,0.12);border-color:var(--ember)}
button.act-btn:focus-visible{outline:1px solid var(--ember-hot);outline-offset:3px}
.scroll-cue{
  position:absolute;left:28px;bottom:30px;color:var(--faint);font-size:11px;letter-spacing:0.14em;
  opacity:0;transition:opacity 1.2s;pointer-events:none;
}
.scroll-cue.show{opacity:1}

/* ---------- below the fold ---------- */
main{max-width:660px;margin:0 auto;padding:0 24px}
section{padding:110px 0 0}
.eyebrow{color:var(--ember);margin-bottom:26px;display:block}
h2{
  font-family:'Cormorant Garamond',Georgia,serif;font-weight:400;
  font-size:clamp(28px,4.5vw,40px);line-height:1.2;margin-bottom:28px;letter-spacing:0.02em;
}
p{color:var(--slate);font-size:16.5px;margin-bottom:1.5em}
p strong{color:var(--ivory);font-weight:400}
.rule{width:44px;height:1px;background:var(--ember);opacity:0.6;margin:70px auto 0}

/* ledger */
.ledger{border-top:1px solid var(--hairline)}
.entry{
  display:grid;grid-template-columns:150px 1fr;gap:28px;
  padding:34px 0;border-bottom:1px solid var(--hairline);
}
.entry .k{color:var(--ember);padding-top:6px}
.entry p{margin:0;font-size:15.5px}
.entry .tw-a{color:var(--twin-a)}
.entry .tw-b{color:var(--twin-b)}
@media(max-width:560px){.entry{grid-template-columns:1fr;gap:8px}}

/* letter */
.letter{
  border:1px solid var(--hairline);border-radius:3px;
  padding:clamp(30px,6vw,58px);position:relative;
  background:linear-gradient(160deg,rgba(13,13,36,0.5),rgba(6,6,18,0));
}
.letter::before{
  content:"";position:absolute;top:-1px;left:50%;transform:translateX(-50%);
  width:44px;height:1px;background:var(--ember);
}
.letter p{font-size:16.5px}
.letter .salutation{color:var(--ivory);font-style:italic;font-family:'Cormorant Garamond',Georgia,serif;font-size:20px}
.sig{margin-top:44px;padding-top:26px;border-top:1px solid var(--hairline)}
.sig .name{
  font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-weight:400;
  font-size:30px;color:var(--ivory);
}
.sig .role{color:var(--faint);font-size:12px;letter-spacing:0.14em;margin-top:6px}

/* footer */
footer{
  margin-top:130px;padding:44px 24px 54px;text-align:center;
  border-top:1px solid var(--hairline);
}
footer .mono{color:var(--faint)}
footer a{color:var(--slate);text-decoration:none;border-bottom:1px solid var(--hairline);transition:color .3s,border-color .3s}
footer a:hover{color:var(--ember);border-color:var(--ember)}
.spark-dot{color:var(--ember)}

@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *{transition-duration:0.01ms !important}
}
</style>
